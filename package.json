{
  "name": "app_defesa_civil_expo",
  "version": "1.3.71",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "diagnose": "node scripts/diagnostico.mjs",
    "diagnose:rapido": "node scripts/diagnostico.mjs --rapido",
    "test:subscription-concurrency": "node scripts/test-subscription-concurrency.mjs",
    "test:migration-versions": "node scripts/test-migration-versions.mjs",
    "test:subscription-migration": "node scripts/test-subscription-migration.mjs",
    "test:official-protocol-allocation": "node scripts/test-official-protocol-allocation.mjs",
    "test:agent-detail": "node scripts/test-internal-agent-detail.mjs",
    "test:archive-restore": "node scripts/test-archive-restore-security.mjs",
    "test:document-acknowledgement-web": "node scripts/test-document-acknowledgement-web-contract.mjs",
    "test:document-acknowledgement-links": "node --experimental-strip-types --test scripts/test-document-acknowledgement-links.mjs",
    "test:document-release-workflow": "node --no-warnings --experimental-strip-types --test scripts/test-document-release-workflow.mjs",
    "test:document-release-integration": "node --test scripts/test-document-release-integration.mjs",
    "test:document-acknowledgement-sqlite": "node --no-warnings --experimental-strip-types --test scripts/test-document-acknowledgement-sqlite-migration.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.112.2",
    "canvas": "^3.2.3",
    "expo": "~58.0.24",
    "expo-asset": "~58.0.20",
    "expo-auth-session": "~58.0.18",
    "expo-background-fetch": "~58.0.12",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.20",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.9",
    "expo-print": "~58.0.8",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.16",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@electric-sql/pglite": "^0.5.4",
    "@expo/ngrok": "^4.1.0",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "setupFilesAfterEnv": [],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dashboard/",
      "/bot-whatsapp/",
      "/.claude/worktrees/",
      "/\\.claude/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx"
    ],
    "testMatch": [
      "**/?(*.)+(spec|test).[jt]s?(x)"
    ],
    "collectCoverageFrom": [
      "utils/**/*.ts",
      "services/**/*.ts",
      "context/**/*.tsx",
      "!**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 20
      }
    }
  },
  "private": true
}
