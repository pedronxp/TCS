{
  "name": "app_defesa_civil_expo",
  "version": "1.3.32",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:subscription-concurrency": "node scripts/test-subscription-concurrency.mjs",
    "test:subscription-migration": "node scripts/test-subscription-migration.mjs",
    "test:official-protocol-allocation": "node scripts/test-official-protocol-allocation.mjs",
    "test:agent-detail": "node scripts/test-internal-agent-detail.mjs",
    "test:archive-restore": "node scripts/test-archive-restore-security.mjs",
    "test:document-acknowledgement-web": "node scripts/test-document-acknowledgement-web-contract.mjs",
    "test:document-acknowledgement-links": "node --experimental-strip-types --test scripts/test-document-acknowledgement-links.mjs",
    "test:document-release-workflow": "node --no-warnings --experimental-strip-types --test scripts/test-document-release-workflow.mjs",
    "test:document-release-integration": "node --test scripts/test-document-release-integration.mjs",
    "test:document-acknowledgement-sqlite": "node --no-warnings --experimental-strip-types --test scripts/test-document-acknowledgement-sqlite-migration.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@supabase/supabase-js": "^2.112.2",
    "canvas": "^3.2.3",
    "expo": "~57.0.16",
    "expo-asset": "~57.0.14",
    "expo-auth-session": "~57.0.9",
    "expo-background-fetch": "~57.0.13",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.14",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.13",
    "expo-image-picker": "~57.0.13",
    "expo-linking": "~57.0.7",
    "expo-local-authentication": "~57.0.2",
    "expo-location": "~57.0.13",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.14",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.15",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.13",
    "expo-web-browser": "~57.0.2",
    "leaflet": "1.9.4",
    "leaflet.heat": "0.2.0",
    "leaflet.markercluster": "1.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.87.0",
    "react-native-map-clustering": "^4.0.0",
    "react-native-maps": "1.29.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "15.15.5",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "14.0.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@electric-sql/pglite": "^0.5.4",
    "@expo/ngrok": "^4.1.0",
    "@testing-library/react-native": "^12.4.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.1.17",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "typescript": "~5.9.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dashboard/",
      "/bot-whatsapp/",
      "/.claude/worktrees/",
      "/\\.claude/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx"
    ],
    "testMatch": [
      "**/?(*.)+(spec|test).[jt]s?(x)"
    ],
    "collectCoverageFrom": [
      "utils/**/*.ts",
      "services/**/*.ts",
      "context/**/*.tsx",
      "!**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 20
      }
    }
  },
  "private": true
}
