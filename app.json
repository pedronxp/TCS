{
  "expo": {
    "name": "TCS - Relatório de Risco",
    "slug": "tcs-relatorio-de-risco",
    "scheme": "tcs",
    "version": "1.3.26",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF",
      "dark": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tcs.relatorioderisco",
      "buildNumber": "29",
      "infoPlist": {
        "NSCameraUsageDescription": "O app precisa acessar a câmera para registrar evidências fotográficas das vistorias.",
        "NSPhotoLibraryUsageDescription": "O app precisa acessar a galeria para anexar fotos às vistorias.",
        "NSLocationWhenInUseUsageDescription": "O app usa a localização para registrar o ponto exato de cada vistoria."
      }
    },
    "android": {
      "package": "com.tcs.relatorioderisco",
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD9THUSNNwA0aQ54cacCs9o0-SloWA9hPY"
        }
      },
      "versionCode": 32,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2F7D6D",
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O app acessa a galeria para anexar evidências fotográficas às vistorias.",
          "cameraPermission": "O app usa a câmera para registrar evidências das vistorias."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O app usa a localização para registrar o ponto exato das vistorias.",
          "locationAlwaysPermission": "O app usa a localização em segundo plano para vistorias contínuas.",
          "locationWhenInUsePermission": "O app usa a localização para registrar onde a vistoria está sendo realizada.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "87a0211d-3965-48dd-a3bd-4b737f844de1"
      }
    },
    "owner": "pedronxp"
  }
}
