{
  "expo": {
    "name": "TCS - Relatório de Risco",
    "slug": "tcs-relatorio-de-risco",
    "scheme": "tcs",
    "version": "1.3.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F19"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tcs.relatorioderisco",
      "infoPlist": {
        "NSCameraUsageDescription": "O app precisa acessar a câmera para registrar evidências fotográficas das vistorias.",
        "NSPhotoLibraryUsageDescription": "O app precisa acessar a galeria para anexar fotos às vistorias.",
        "NSLocationWhenInUseUsageDescription": "O app usa a localização para registrar o ponto exato de cada vistoria.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "O app usa a localização para registrar vistorias mesmo em segundo plano."
      }
    },
    "android": {
      "package": "com.tcs.relatorioderisco",
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD9THUSNNwA0aQ54cacCs9o0-SloWA9hPY"
        }
      },
      "versionCode": 11,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0B0F19"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3B82F6",
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O app acessa a galeria para anexar evidências fotográficas às vistorias.",
          "cameraPermission": "O app usa a câmera para registrar evidências das vistorias."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O app usa a localização para registrar o ponto exato das vistorias.",
          "locationAlwaysPermission": "O app usa a localização em segundo plano para vistorias contínuas.",
          "locationWhenInUsePermission": "O app usa a localização para registrar onde a vistoria está sendo realizada.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f0684d3e-3fc0-4605-a514-2fad941b1449"
      },
      "router": {}
    },
    "owner": "pedrontz"
  }
}
